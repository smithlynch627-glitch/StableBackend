# ───────────────────────── Server ─────────────────────────
NODE_ENV=production
PORT=8080
# Public https URL of this API (used for hosted images when IPFS is not configured)
API_PUBLIC_URL=https://your-api.up.railway.app
# Public marketplace site(s) allowed to call the API (add http://localhost:5173 for local dev)
CORS_ORIGINS=https://your-site.netlify.app
# The separate ADMIN site(s). Admin endpoints refuse every other origin (add http://localhost:5174 for local dev)
ADMIN_ORIGINS=https://admin-your-site.netlify.app
# 48 random bytes. PowerShell (cryptographically secure):
# $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# 32 random bytes for AES-256-GCM. Same command with 32 instead of 48. NEVER change it after launch.
DATA_ENCRYPTION_KEY=
# Root admins (owner role, cannot be removed from the panel). Comma separated wallet addresses.
ADMIN_ADDRESSES=

# ───────────────────────── Database ───────────────────────
# Supabase → Connect → Session pooler. Use the least-privilege stable_api role (db/02_api_role.sql):
DATABASE_URL=postgresql://stable_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional but recommended: Supabase CA certificate (Settings → Database → SSL) to verify the server.
# Paste the PEM (with \n for new lines) or a file path.
DATABASE_CA_CERT=

# ───────── Network (.env controls it until someone edits the network in the admin panel) ─────────
CHAIN_ID=91342
RPC_URL=https://sepolia-rpc.giwa.io
PUBLIC_RPC_URL=https://sepolia-rpc.giwa.io
EXPLORER_URL=https://sepolia-explorer.giwa.io
EXPLORER_API_URL=https://sepolia-explorer.giwa.io/api/v2
MARKET_ADDRESS=
LAUNCHPAD_FACTORY_ADDRESS=
FEE_VAULT_ADDRESS=
WETH_ADDRESS=0x4200000000000000000000000000000000000006
OFFICIAL_COLLECTION_ADDRESS=
INDEXER_START_BLOCK=0

# ───────────────────────── Optional ───────────────────────
# Pinata JWT (needs pinning + API key admin rights) for IPFS uploads from the Create page and Studio.
# Without it creators can still launch with a pre-reveal image/link or an IPFS folder they uploaded themselves.
PINATA_JWT=
# Optional: your dedicated IPFS gateway (e.g. https://yourname.mypinata.cloud/ipfs/), tried first when loading metadata
IPFS_GATEWAY=
VERIFIED_COLLECTIONS=
INDEXER_POLL_MS=3000
